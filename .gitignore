# ── 数据一律不进仓库 ──────────────────────────────
# 信令和明细表能识别到个人；数据库文件也很大
data/
*.db
*.sqlite
# CSV 默认也不进：防止把导出的明细表误提交
*.csv
# 例外：文档里的口径表、测试用的小样例可以进
!docs/*.csv
!tests/**/*.csv

# ── 产物：随时可以由代码重新生成 ────────────────────
image/
reports/

# ── Python 和 Jupyter 的缓存 ───────────────────────
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/

# ── 编辑器和系统文件 ───────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db